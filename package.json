{
  "name": "@ankhorage/utility",
  "type": "module",
  "version": "0.2.0",
  "description": "Shared, runtime-neutral utilities for Ankhorage packages and compatible external projects.",
  "homepage": "https://github.com/ankhorage/utility#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/utility/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/utility.git"
  },
  "keywords": [
    "typescript",
    "utilities",
    "project-detection",
    "regex",
    "react",
    "react-native",
    "expo"
  ],
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./project": {
      "types": "./dist/project/index.d.ts",
      "import": "./dist/project/index.js",
      "default": "./dist/project/index.js"
    },
    "./regex": {
      "types": "./dist/regex/index.d.ts",
      "import": "./dist/regex/index.js",
      "default": "./dist/regex/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.9.4",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.0"
}
